rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Customer can upload files up to 25 MB into their own order directory
    match /orders/{userId}/{fileName} {
      allow read: if request.auth != null && (request.auth.uid == userId || request.auth.token.role == 'admin');
      allow write: if request.auth != null 
                   && request.auth.uid == userId
                   && request.resource.size < 25 * 1024 * 1024; // 25 MB max
    }

    // Product and Service images (Public read, admin write)
    match /products/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.role == 'admin';
    }
  }
}

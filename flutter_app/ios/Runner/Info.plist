<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Mukhtar Printing &amp; Store</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>com.mukhtarprinting.umarzai</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>mukhtar_printing_store</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>1.0.0</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>1</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<false/>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>

	<!-- Purpose Strings for Permissions (Apple App Store Requirement) -->
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Mukhtar Printing requires access to your photos to allow you to upload designs, certificates, banners, and documents for printing.</string>
	<key>NSCameraUsageDescription</key>
	<string>Mukhtar Printing needs camera access to let you capture physical documents, book pages, or ID cards for photocopy and printing.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Mukhtar Printing uses your location to provide directions and route estimates to our printing shop at Main Bazar Umarzai.</string>

	<!-- Deep Linking Custom Scheme: mukhtarprinting:// -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLName</key>
			<string>com.mukhtarprinting.umarzai</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>mukhtarprinting</string>
			</array>
		</dict>
	</array>

	<!-- WhatsApp & External Call Schemes -->
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>whatsapp</string>
		<string>tel</string>
		<string>comgooglemaps</string>
		<string>maps</string>
	</array>
</dict>
</plist>
